  <script>
    // HERO SLIDER
    let currentSlide = 0;
    const slides = document.querySelectorAll(".slide");
    const slideContainer = document.getElementById("slides");

    function moveSlide(direction) {
      currentSlide =
        (currentSlide + direction + slides.length) % slides.length;

      slideContainer.style.transform =
        `translateX(-${currentSlide * 100}%)`;
    }

    setInterval(() => moveSlide(1), 5000);

    // MOBILE MENU
    function toggleMenu() {
      document.getElementById("nav").classList.toggle("active");
    }

    document.querySelectorAll(".nav a").forEach(link => {
      link.addEventListener("click", () => {
        document.getElementById("nav").classList.remove("active");
      });
    });

    // SEARCH
    function toggleSearch() {
      const box = document.getElementById("searchBox");
      box.classList.toggle("active");

      if (box.classList.contains("active")) {
        document.getElementById("searchInput").focus();
      }
    }

    // SAMPLE PRODUCTS
    const products = [
      {
        name: "베이직 오버핏 니트",
        category: "women",
        price: 39900,
        discount: 20,
        image: "https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=650&auto=format&fit=crop"
      },
      {
        name: "클래식 데일리 셔츠",
        category: "men",
        price: 45900,
        discount: 10,
        image: "https://images.unsplash.com/photo-1598032895397-b9472444bf93?w=650&auto=format&fit=crop"
      },
      {
        name: "모던 데일리 스니커즈",
        category: "acc",
        price: 59000,
        discount: 15,
        image: "https://images.unsplash.com/photo-1549298916-b41d501d3772?w=650&auto=format&fit=crop"
      },
      {
        name: "미니멀 데일리 백",
        category: "acc",
        price: 49000,
        discount: 0,
        image: "https://images.unsplash.com/photo-1547949003-9792a18a2601?w=650&auto=format&fit=crop"
      },
      {
        name: "소프트 데일리 가디건",
        category: "women",
        price: 52900,
        discount: 20,
        image: "https://images.unsplash.com/photo-1483985988355-763728e1935b?w=650&auto=format&fit=crop"
      },
      {
        name: "베이직 코튼 티셔츠",
        category: "men",
        price: 29900,
        discount: 0,
        image: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=650&auto=format&fit=crop"
      },
      {
        name: "클래식 데일리 슈즈",
        category: "acc",
        price: 69000,
        discount: 10,
        image: "https://images.unsplash.com/photo-1525966222134-fcfa99b8ae77?w=650&auto=format&fit=crop"
      },
      {
        name: "시즌 컬렉션 아우터",
        category: "women",
        price: 89900,
        discount: 25,
        image: "https://images.unsplash.com/photo-1539533018447-63fcce2678e3?w=650&auto=format&fit=crop"
      }
    ];

    let cart = 0;
    let currentCategory = "all";

    function renderProducts(items) {
      const grid = document.getElementById("productGrid");
      grid.innerHTML = "";

      if (items.length === 0) {
        grid.innerHTML = "<p>검색 결과가 없습니다.</p>";
        return;
      }

      items.forEach(product => {
        const finalPrice = Math.round(
          product.price * (1 - product.discount / 100) / 100
        ) * 100;

        const card = document.createElement("div");
        card.className = "product-card";

        card.innerHTML = `
          <div class="product-image">
            <img src="${product.image}" alt="${product.name}" loading="lazy">
            <button class="heart" aria-label="찜하기">♡</button>
          </div>

          <div class="product-info">
            <small>MOOD STORE</small>
            <h3>${product.name}</h3>
            <div class="price">
              ${product.discount > 0
                ? `<span class="discount">${product.discount}%</span>`
                : ""}
              ${finalPrice.toLocaleString()}원
            </div>
            <button class="add-cart">장바구니 담기 +</button>
          </div>
        `;

        card.querySelector(".heart").addEventListener("click", e => {
          e.currentTarget.classList.toggle("active");
          e.currentTarget.textContent =
            e.currentTarget.classList.contains("active") ? "♥" : "♡";
        });

        card.querySelector(".add-cart").addEventListener("click", () => {
          cart++;
          document.getElementById("cartCount").textContent = cart;
          alert("장바구니에 담았습니다.");
        });

        grid.appendChild(card);
      });
    }

    function updateProducts() {
      const query = document.getElementById("searchInput")
        .value.trim().toLowerCase();

      const filtered = products.filter(product => {
        const categoryMatch =
          currentCategory === "all" ||
          product.category === currentCategory;

        const searchMatch =
          product.name.toLowerCase().includes(query);

        return categoryMatch && searchMatch;
      });

      renderProducts(filtered);
    }

    function filterProducts(category, button) {
      currentCategory = category;

      document.querySelectorAll(".filter-buttons button")
        .forEach(btn => btn.classList.remove("active"));

      button.classList.add("active");
      updateProducts();
    }

    function searchProducts() {
      updateProducts();
      document.getElementById("best").scrollIntoView({
        behavior: "smooth"
      });
    }

    function showCart() {
      alert(`장바구니에 ${cart}개의 상품이 담겨 있습니다.`);
    }

    renderProducts(products);
  </script>

</body>
</html>
